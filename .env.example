# ---- Blink Subscriptions — environment ----

# DATABASE
# Local dev: leave blank -> uses a local file (.data/blinksub.db).
# Production (Vercel): set to a Turso libSQL url + token (the local file won't persist on Vercel).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ADVANCED CONNECTOR verification (read-only key for YOUR platform account, circularity).
# Used only to read who sent the unlock payment. Read-only cannot move money.
CIRCULARITY_API_KEY=

# Protects the daily reminder cron. Vercel sends this automatically to the cron endpoint.
CRON_SECRET=
