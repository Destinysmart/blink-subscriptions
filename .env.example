# Leave everything blank to run in DEMO mode (renders with sample data, no backend).
# Fill these to go live:

# Blink
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_PLATFORM_KEY=
SETTLEMENT_WEBHOOK_URL=

# Supabase (server-side SERVICE ROLE key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# protects the cron endpoint (Vercel Cron sends this automatically if set as CRON_SECRET)
CRON_SECRET=
